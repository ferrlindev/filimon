# Copy to .env next to filimon.toml; real environment variables override it; never commit .env.
# fili reads every value literally and never expands $NAME or ${NAME}.
# Wrap a value in single quotes when it contains $, a backslash, whitespace, a double quote, or starts with #: KEY='pa$$word'
# Rejected with a line number: unquoted or double-quoted $ or backslash, multi-line values, duplicate keys.
# A value containing ' plus $ or a backslash cannot go here; set it in the process environment, which overrides this file.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
