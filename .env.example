# Copy to .env at the repository root. The credentialed tests
# (`cargo test -p filimon e2e_credentialed_`) and `scripts/live-e2e.sh` read it.
# Real environment variables override this file. Never commit .env.
# Values are read literally and never expanded: wrap a value in single quotes
# when it contains $, a backslash, whitespace, a double quote, or starts with #:
# KEY='pa$$word'
# A key left empty counts as missing: the matching test prints
# `skipped: missing <KEY>` and passes.

# Client id of an app-only Reddit web app (https://www.reddit.com/prefs/apps);
# its secret is the next key.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key.
YOUTUBE_API_KEY=
# Optional contact such as u/yourname; a default is used when empty.
REDDIT_USER_AGENT_CONTACT=
